{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ayat",
  "version": "0.1.0",
  "identifier": "com.rifizzu.ayat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ayat",
        "width": 1200,
        "height": 840,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; connect-src 'self' https://api.quran.com https://equran.id https://everyayah.com https://tilawa.dev; media-src 'self' blob: https://everyayah.com; worker-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**",
          "$APPDATA/**",
          "../public/mushaf/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/mushaf/pages/*": "mushaf/pages/"
    },
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  }
}
